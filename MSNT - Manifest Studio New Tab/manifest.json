{
  "manifest_version": 3,
  "name": "Manifest Studio",
  "version": "1.7.9",
  "description": "Manifest Studio \u2014 customizable Chrome new tab with monospace typography, Openverse wallpaper search, persistent wallpapers, transparent cards, bookmarks and local weather.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://suggestqueries.google.com/*",
    "https://www.google.com/s2/favicons/*",
    "https://picsum.photos/*",
    "https://api.openverse.org/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_permissions": [
    "bookmarks"
  ]
}